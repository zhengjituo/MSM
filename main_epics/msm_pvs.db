# ============================================================
# msm_pvs.db —— 由 gen_db.py 从 pv_map.json 生成，请勿手改
# source: config/pv_map.json
# 加载方式:
#   softIoc -m "P=MSM:,I=" -d msm_pvs.db
# ============================================================

# ---- group fast (10 Hz) ----
record(ai, "$(P)$(I)Process:x_pos") {
    field(DTYP, "Soft Channel")
    field(PREC, "3")
    field(EGU,  "mm")
    field(LOPR, "-1e9")
    field(HOPR, "1e9")
    field(ADEL, "0")
    field(SCAN, "Passive")
}

record(ai, "$(P)$(I)Process:y_pos") {
    field(DTYP, "Soft Channel")
    field(PREC, "3")
    field(EGU,  "mm")
    field(LOPR, "-1e9")
    field(HOPR, "1e9")
    field(ADEL, "0")
    field(SCAN, "Passive")
}

record(ai, "$(P)$(I)Process:intensity") {
    field(DTYP, "Soft Channel")
