{
    "_comment": "MSM EPICS PV 映射 —— 唯一人写的地方。新增/移除对外 PV 只改这里；.db 与 pydm .ui 都由它生成。",
    "_prefix_note": "pv 名使用 ${P}${I} 前缀宏，值来自 config/pre.cfg（或环境变量 MSM_P / MSM_I）。",
    "_rate_note": "rate_hz 为分组推送频率，允许范围 2-10Hz；wave_nelm 必须与 EPICS waveform 记录的 NELM 一致。",
    "ipc": "/tmp/msm_daq.sock",
    "ioc": {
        "addr_list": "127.0.0.1:5064"
    },
    "_control_note": "PyDM ==CA==> 桥 ==IPC==> backend。PyDM 不连 socket，只写下面这些 PV；桥负责转发并回写 resp/状态。",
    "control": {
        "commands": [
            {
                "pv": "${P}${I}CTRL:start",
                "cmd": "START"
            },
            {
                "pv": "${P}${I}CTRL:stop",
                "cmd": "STOP"
            },
            {
                "pv": "${P}${I}CTRL:quit",
                "cmd": "QUIT"
            }
        ],
        "save_pv": {
            "pv": "${P}${I}CTRL:save_enable",
            "on": "ENABLESAVE",
            "off": "DISABLESAVE"
        },
        "msg_pv": {
            "pv": "${P}${I}CTRL:msg"
        },
        "_frame_index_note": "stringout 的 VAL 只有 40 字符，塞不下 'MSG SetFrameIndex >> index=N -@ Process'，故用数值 PV 由桥拼命令。",
        "frame_index_pv": {
            "pv": "${P}${I}CTRL:set_frame_index"
        },
        "status": {
            "backend_alive": "${P}${I}CTRL:backend_alive",
            "daq_running": "${P}${I}CTRL:daq_running",
            "resp": "${P}${I}CTRL:resp"
        }
    },
    "groups": {
        "fast": {
            "rate_hz": 10,
            "_note": "高频：位置与强度，客户看趋势曲线",
            "vars": [
                {
                    "from": "Process:x_pos",
                    "pv": "${P}${I}Process:x_pos",
                    "egu": "mm",
                    "prec": 3
                },
                {
                    "from": "Process:y_pos",
                    "pv": "${P}${I}Process:y_pos",
                    "egu": "mm",
                    "prec": 3
                },
                {
                    "from": "Process:intensity",
                    "pv": "${P}${I}Process:intensity",
                    "egu": "a.u.",
                    "prec": 3
                }
            ]
        },
        "slow": {
            "rate_hz": 2,
            "_note": "低频：计数器与特征表，2Hz 足以表达速率",
