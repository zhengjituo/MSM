    field(DESC, "MultiplyModule:a")
}

record(longout, "MSM:MultiplyModule:b") {
    field(DESC, "MultiplyModule:b")
}

record(longin, "MSM:MultiplyModule:result") {
    field(DESC, "MultiplyModule:result")
}

record(longout, "MSM:MultiplyModule:action") {
    field(DESC, "MultiplyModule:action")
}

record(longout, "MSM:MultiplyModule:callRemote") {
    field(DESC, "MultiplyModule:callRemote")
}

record(longin, "MSM:MultiplyModule:remoteResult") {
